# ── Required ────────────────────────────────────────────────────────────────
# GitHub Personal Access Token with read:org and repo scopes
GITARENA_PAT=ghp_your_token_here

# GitHub organisation slug (the part after github.com/)
GITARENA_ORG=your-org-name

# ── Optional ─────────────────────────────────────────────────────────────────
# Comma-separated list of repo names to watch (leave empty = all org repos)
# GITARENA_REPOS=repo-a,repo-b,repo-c

# Backend port (default: 3002)
# PORT=3002

# Secret required on X-Admin-Secret header for /api/recalculate and /api/repair.
# Leave unset (or empty) to disable the guard during local development.
# GITARENA_ADMIN_SECRET=change_me_in_production
